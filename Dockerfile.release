# Release-only runtime image — see docs/architecture/release-pipeline.md
# § Container matrix for why this exists alongside the regular `Dockerfile`
# (which stays the reference source build; this one just copies a binary
# `release.yml`'s build-binaries job already compiled).
#
# Keep this stage (base digest, USER, EXPOSE, ENTRYPOINT) in sync with
# Dockerfile's final stage — they must match, but nothing enforces it.
FROM gcr.io/distroless/cc-debian13:nonroot@sha256:08476c244888bfb425bae1ae4dd7c17f093e972aab8426883d97f3c6f280f7c1
COPY atc-server /atc-server
USER 65532:65532
EXPOSE 8080
EXPOSE 9090
ENTRYPOINT ["/atc-server"]
