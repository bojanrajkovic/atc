{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "changelog-path": "CHANGELOG.md",
  "packages": {
    ".": {
      "extra-files": [
        { "type": "toml", "path": "backend/Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "json", "path": "frontend/package.json", "jsonpath": "$.version" },
        { "type": "yaml", "path": "deploy/helm/atc/Chart.yaml", "jsonpath": "$.version" },
        { "type": "yaml", "path": "deploy/helm/atc/Chart.yaml", "jsonpath": "$.appVersion" }
      ]
    }
  }
}
