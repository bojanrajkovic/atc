{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "skip-github-release": true,
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "packages": {
    "backend/crates/atc-core": {
      "release-type": "rust",
      "component": "atc-core"
    },
    "backend/crates/atc-github": {
      "release-type": "rust",
      "component": "atc-github"
    },
    "backend/crates/atc-server": {
      "release-type": "rust",
      "component": "atc-server"
    },
    "frontend": {
      "release-type": "node",
      "component": "frontend"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "atc",
      "components": ["atc-core", "atc-github", "atc-server", "frontend"]
    }
  ]
}
